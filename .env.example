# Backend

HTTP_ADDR=:8080
DATABASE_PATH=data/omepic.db
REDIS_URL=redis://localhost:6379/0

# Plaintext UID prefix before XOR obfuscation; trailing underscores are normalized.
UID_PREFIX=omeo_

# H-01: all secrets are required. Set strong random values before starting.
# Generate random 32+ character strings for each secret.
UID_ENCRYPTION_KEY=<your-uid-obfuscation-key>
JWT_SECRET=<your-jwt-signing-secret>
ADMIN_PASSWORD=<your-admin-password>
