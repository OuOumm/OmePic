# OmePic Production Configuration
# Copy this file to .env and fill in all values.
# All SECRET_* and JWT_SECRET fields are mandatory; the server will refuse to start if any is missing.

# --- Required Secrets (MUST be set) ---
# Admin password for the management dashboard.
# Not enforced via env since H-01 uses DB-seeded default, but recommended in production.
ADMIN_PASSWORD=

# JWT signing secret — at least 32 characters, cryptographically random.
JWT_SECRET=

# UID obfuscation key (env name kept for compatibility; this is XOR-based ID encoding, NOT a cryptographic boundary).
# At least 32 characters.
UID_ENCRYPTION_KEY=

# AES-256-GCM key for encrypting storage credentials in SQLite — exactly 32 bytes (256-bit).
SECRET_ENCRYPTION_KEY=

# --- Network & Storage ---
# Listen address (default :8080).
HTTP_ADDR=:8080

# SQLite database file path.
DATABASE_PATH=data/omepic.db

# Redis URL for caching, rate limiting, and JWT revocation.
REDIS_URL=redis://localhost:6379/0

# Public-facing base URL for generated image links (required in production).
PUBLIC_BASE_URL=https://img.example.com

# UID prefix for generated IDs.
UID_PREFIX=omeo_

# --- Environment ---
# Set to "production" to enforce strict security checks.
# Leave empty or "development" for relaxed checks.
APP_ENV=production